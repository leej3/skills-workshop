{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leej3/skills-workshop/schemas/memory/tag-v0.schema.json",
  "title": "Skills Workshop Tag v0",
  "type": "object",
  "required": ["schema", "id", "slug", "definition", "aliases", "created_at", "updated_at"],
  "properties": {
    "schema": {
      "const": "https://github.com/leej3/skills-workshop/schemas/memory/tag-v0.schema.json"
    },
    "id": {"$ref": "#/$defs/urn_uuid"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "definition": {"type": "string", "minLength": 1, "maxLength": 2048},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 128},
      "uniqueItems": true
    },
    "deprecated_by": {"$ref": "#/$defs/urn_uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "urn_uuid": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
