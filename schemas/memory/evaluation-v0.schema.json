{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leej3/skills-workshop/schemas/memory/evaluation-v0.schema.json",
  "title": "Skills Workshop Controlled Evaluation v0",
  "type": "object",
  "required": [
    "schema",
    "id",
    "skill_id",
    "created_at",
    "status",
    "design",
    "hypothesis",
    "protocol",
    "fixture",
    "conditions",
    "cases",
    "metrics",
    "runs",
    "grading",
    "analysis",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "https://github.com/leej3/skills-workshop/schemas/memory/evaluation-v0.schema.json"
    },
    "id": {"$ref": "#/$defs/urn_uuid"},
    "skill_id": {"$ref": "#/$defs/urn_uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["planned", "running", "complete", "abandoned"]},
    "design": {"enum": ["exploratory", "controlled-paired", "replicated"]},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4096},
    "protocol": {"$ref": "#/$defs/reference"},
    "fixture": {"$ref": "#/$defs/reference"},
    "conditions": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/condition"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "runs": {
      "type": "array",
      "items": {"$ref": "#/$defs/run"}
    },
    "grading": {
      "type": "object",
      "required": ["kind", "grader", "rubric", "blinded"],
      "properties": {
        "kind": {"enum": ["human", "agent", "deterministic", "mixed", "unassigned"]},
        "grader": {"type": ["object", "null"]},
        "rubric": {"anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
        "blinded": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": ["conclusion", "summary", "limitations"],
      "properties": {
        "conclusion": {"enum": ["planned", "better", "neutral", "worse", "inconclusive"]},
        "summary": {"type": "string", "maxLength": 10000},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      },
      "additionalProperties": false
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "additionalProperties": false,
  "$defs": {
    "urn_uuid": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reference": {
      "type": "object",
      "required": ["uri", "digest"],
      "properties": {
        "uri": {"type": "string", "minLength": 1, "maxLength": 4096},
        "digest": {"type": ["string", "null"], "maxLength": 512}
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": [
        "id",
        "label",
        "skill_enabled",
        "artifact_id",
        "runtime",
        "isolation"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "skill_enabled": {"type": "boolean"},
        "artifact_id": {"anyOf": [{"$ref": "#/$defs/urn_uuid"}, {"type": "null"}]},
        "runtime": {
          "type": "object",
          "required": ["agent", "agent_version", "model", "reasoning_effort", "tools", "permissions", "budget"],
          "properties": {
            "agent": {"type": "string", "minLength": 1},
            "agent_version": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "reasoning_effort": {"type": ["string", "null"]},
            "tools": {"type": "array", "items": {"type": "string"}},
            "permissions": {"type": "array", "items": {"type": "string"}},
            "budget": {"$ref": "#/$defs/budget"}
          },
          "additionalProperties": false
        },
        "isolation": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["time_seconds", "token_limit", "turn_limit", "notes"],
      "properties": {
        "time_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "token_limit": {"type": ["integer", "null"], "minimum": 1},
        "turn_limit": {"type": ["integer", "null"], "minimum": 1},
        "notes": {"type": "string", "maxLength": 2048}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["id", "prompt", "fixture_revision", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
        "fixture_revision": {"type": ["string", "null"], "maxLength": 512},
        "expected": {"type": "string", "minLength": 1, "maxLength": 10000}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["id", "description", "unit", "direction"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2048},
        "unit": {"type": "string", "minLength": 1, "maxLength": 128},
        "direction": {"enum": ["higher-better", "lower-better", "target"]}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["id", "condition_id", "case_id", "started_at", "outcome", "metrics", "evidence", "notes"],
      "properties": {
        "id": {"$ref": "#/$defs/urn_uuid"},
        "condition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "started_at": {"type": "string", "format": "date-time"},
        "outcome": {"enum": ["success", "partial", "failure", "error"]},
        "metrics": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {"type": "number"}
          },
          "additionalProperties": false
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "notes": {"type": "string", "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$": {}
      },
      "additionalProperties": false
    }
  }
}
