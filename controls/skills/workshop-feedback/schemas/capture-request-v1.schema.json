{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit skill-use capture inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversation",
    "duct_runs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "codex-jsonl",
            "jsonl",
            "text"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "duct_runs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skill_path": {
      "type": "string",
      "minLength": 1
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  }
}
